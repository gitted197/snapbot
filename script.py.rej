@@ -10,6 +10,49 @@
 setup_logging()
 logger = logging.getLogger(__name__)
 
+def format_duration(seconds: float) -> str:
+    total_seconds = int(round(seconds))
+    minutes, secs = divmod(total_seconds, 60)
+    hours, minutes = divmod(minutes, 60)
+
+    if hours:
+        return f"{hours}h {minutes}m {secs}s"
+    if minutes:
+        return f"{minutes}m {secs}s"
+    return f"{secs}s"
+
+
+def click_camera_or_continue(device) -> bool:
+    """
+    Click the camera button, unless Snapchat is already on the preview screen.
+
+    Returns True when the next/send button was already clicked here, so the
+    caller must not click it again. Returns False when the normal camera click
+    succeeded and the caller should continue with the next/send button.
+    """
+    try:
+        ClickButton("clicking_camera", device).ClickNow(
+            "com.snapchat.android:id/camera_capture_button", None
+        )
+        return False
+    except RuntimeError:
+        logger.warning("Camera button not found. Checking if snap was already taken...")
+
+    try:
+        ClickButton("clicking_next", device).ClickNow(
+            "com.snapchat.android:id/send_btn", None
+        )
+        logger.info("Already on preview screen; clicked next instead of camera.")
+        return True
+    except RuntimeError:
+        logger.warning("Camera and next button not found. Rebooting Snapchat and retrying camera.")
+        rebootSnap(device)
+
+        ClickButton("clicking_camera", device).ClickNow(
+            "com.snapchat.android:id/camera_capture_button", None
+        )
+        return False
+
 def mainScript(username_input: str, points_input_raw) -> int:
     logger.debug("Function mainScript received username=%s", username_input)
 
