-def mainScript(username_input: str, points_input_raw) -> int:
+CAMERA_CAPTURE_BUTTON_ID = "com.snapchat.android:id/camera_capture_button"
+NEXT_BUTTON_ID = "com.snapchat.android:id/send_btn"
+USER_BUTTON_ID = "com.snapchat.android:id/send_to_user"
+SEND_BUTTON_ID = "com.snapchat.android:id/send_to_send_button"
+BACK_TO_CAMERA_BUTTON_ID = "com.snapchat.android:id/ngs_camera_icon_container"
+SCREEN_DETECT_PHASE = "screen_detect"
+MAX_TRANSITIONS_PER_SNAP = 12
+
+FLOW_NEXT_STEP = {
+    "camera": "next",
+    "next": "user",
+    "user": "send",
+    "send": "back",
+    "back": "done",
+}
+
+FLOW_RECOVERY_PRIORITY = {
+    # If camera is missing, the photo may already be taken.
+    "camera": ("next", "user", "send", "back", "camera"),
+    # If next is missing, the app may already have advanced to the recipient list.
+    "next": ("user", "send", "back", "camera", "next"),
+    # If selecting the user fails, prefer send/back when visible because the user
+    # may already be selected. Clicking the user again could toggle selection off.
+    "user": ("send", "back", "camera", "user", "next"),
+    "send": ("send", "back", "camera", "user", "next"),
+    "back": ("back", "camera", "send", "user", "next"),
+}
+
+
+class FlowRecovery:
+    def __init__(self) -> None:
+        self.reboot_used = False
+
+    def reset_after_success(self) -> None:
+        self.reboot_used = False
+
+    def reboot_once_and_restart(self, device, reason: str) -> str:
+        if self.reboot_used:
+            raise RuntimeError(
+                f"Could not recover Snapchat flow after reboot. Last reason: {reason}"
+            )
+
+        logger.warning("%s Rebooting Snapchat once and restarting this snap.", reason)
+        rebootSnap(device)
+        self.reboot_used = True
+        return "camera"
+
+
+def formatDuration(seconds: float) -> str:
+    seconds_int = int(round(seconds))
+    minutes, seconds = divmod(seconds_int, 60)
+    hours, minutes = divmod(minutes, 60)
+
+    if hours:
+        return f"{hours}h {minutes}m {seconds}s"
+    if minutes:
+        return f"{minutes}m {seconds}s"
+    return f"{seconds}s"
+
+
+def _xml_has_resource_id(tree: ET.ElementTree, resource_id: str) -> bool:
+    return any(
+        node.attrib.get("resource-id") == resource_id
+        for node in tree.iter("node")
+    )
+
+
+def _xml_has_text(tree: ET.ElementTree, text: str) -> bool:
+    return any(node.attrib.get("text") == text for node in tree.iter("node"))
+
+
+def detectVisibleFlowScreens(device, username_input: str) -> set[str]:
+    """Return the known Snapchat flow buttons/screens that are currently visible."""
+    try:
+        getDump(device, SCREEN_DETECT_PHASE)
+        tree = ET.parse(str(XML_DIR / f"{SCREEN_DETECT_PHASE}.xml"))
+    except Exception:
+        logger.exception("Could not detect current Snapchat screen")
+        return set()
+
+    visible: set[str] = set()
+    if _xml_has_resource_id(tree, CAMERA_CAPTURE_BUTTON_ID):
+        visible.add("camera")
+    if _xml_has_resource_id(tree, NEXT_BUTTON_ID):
+        visible.add("next")
+    if _xml_has_text(tree, username_input):
+        visible.add("user")
+    if _xml_has_resource_id(tree, SEND_BUTTON_ID):
+        visible.add("send")
+    if _xml_has_resource_id(tree, BACK_TO_CAMERA_BUTTON_ID):
+        visible.add("back")
+    return visible
+
+
+def chooseRecoveryStep(expected_step: str, visible: set[str]) -> str | None:
+    # If send/back was expected but the camera is already visible, the previous
+    # tap probably succeeded and the snap is complete.
+    if expected_step in {"send", "back"} and "camera" in visible and "send" not in visible:
+        return "done"
+
+    for step in FLOW_RECOVERY_PRIORITY[expected_step]:
+        if step in visible:
+            return step
+    return None
+
+
+def clickFlowStep(device, step: str, username_input: str) -> str:
+    if step == "camera":
+        ClickButton("clicking_camera", device).ClickNow(CAMERA_CAPTURE_BUTTON_ID, None)
+        sleep(1)
+    elif step == "next":
+        ClickButton("clicking_next", device).ClickNow(NEXT_BUTTON_ID, None)
+        sleep(0.25)
+    elif step == "user":
+        ClickButton("clicking_user", device).ClickNow(USER_BUTTON_ID, username_input)
+        sleep(0.25)
+    elif step == "send":
+        ClickButton("clicking_send", device).ClickNow(SEND_BUTTON_ID, None)
+        sleep(0.25)
+    elif step == "back":
+        ClickButton("back_to_camera", device).ClickNow(BACK_TO_CAMERA_BUTTON_ID, None)
+    else:
+        raise RuntimeError(f"Unknown flow step: {step}")
+
+    return FLOW_NEXT_STEP[step]
+
+
+def recoverFlowStep(device, expected_step: str, username_input: str, recovery: FlowRecovery) -> str:
+    visible = detectVisibleFlowScreens(device, username_input)
+    logger.warning(
+        "Expected step %s failed. Visible flow buttons/screens: %s",
+        expected_step,
+        ", ".join(sorted(visible)) if visible else "none",
+    )
+
+    recovery_step = chooseRecoveryStep(expected_step, visible)
+    if recovery_step is None:
+        return recovery.reboot_once_and_restart(
+            device,
+            f"No known Snapchat flow button found after {expected_step!r} failed.",
+        )
+
+    if recovery_step == expected_step:
+        return recovery.reboot_once_and_restart(
+            device,
+            f"Detected {expected_step!r}, but clicking it still failed.",
+        )
+
+    logger.info(
+        "Recovering Snapchat flow: expected %s, detected %s. Continuing from there.",
+        expected_step,
+        recovery_step,
+    )
+    return recovery_step
+
+
+def sendOneSnap(device, username_input: str, recovery: FlowRecovery) -> None:
+    step = "camera"
+    transitions = 0
+
+    while step != "done":
+        transitions += 1
+        if transitions > MAX_TRANSITIONS_PER_SNAP:
+            step = recovery.reboot_once_and_restart(
+                device,
+                "Too many Snapchat flow transitions while sending one snap.",
+            )
+            transitions = 0
+            continue
+
+        try:
+            step = clickFlowStep(device, step, username_input)
+        except RuntimeError:
+            step = recoverFlowStep(device, step, username_input, recovery)
+
+    # This is the reset the user asked for: after a reboot fixed the flow and a
+    # snap finishes successfully, a later problem is allowed to reboot again.
+    recovery.reset_after_success()
+
+
+def mainScript(username_input: str, points_input_raw) -> tuple[int, float]:
     logger.debug("Function mainScript received username=%s", username_input)
 
     try:
